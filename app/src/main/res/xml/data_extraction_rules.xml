<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what Android's own Google Drive backup and phone-to-phone transfer copy.
     Database, settings and bahi photos go; caches (PDFs, temp files) don't. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
